# Local development only. Not needed on Vercel (same-origin /api works
# automatically there). Copy this to .env for local `npm run dev`.
VITE_API_URL=http://localhost:4000

# Optional. Enables GET /api/admin/signals?secret=... locally so you can
# view submitted Experiment 01 / Experiment 02 responses during dev.
# Set the same variable in Vercel project settings for production.
# If unset, the admin endpoint is disabled (returns 404).
ADMIN_SECRET=

# Production only, not needed locally. Vercel sets this automatically once
# Blob storage is enabled for the project (Storage -> Create Database ->
# Blob). Without it, submissions fall back to a local JSON file, which
# does NOT persist reliably on Vercel's serverless filesystem.
# BLOB_READ_WRITE_TOKEN=
